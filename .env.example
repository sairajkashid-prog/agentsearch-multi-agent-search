# ============================================================
# AgentSearch - Multi-Agent Search Engine configuration
# Copy this file to .env and edit if needed.
# EVERYTHING IS OPTIONAL: the app runs in 100% free mode by default.
# ============================================================

# Optional: Tavily API key (https://tavily.com - free tier available).
# If set, Tavily becomes the primary search provider.
# Otherwise DuckDuckGo + Wikipedia + Bing RSS fallback are used.
TAVILY_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000

# Search behavior
MAX_SEARCH_RESULTS=10
MAX_PAGES_TO_READ=6
REQUEST_TIMEOUT=10
CACHE_TTL_SECONDS=900

# Agent pipeline
ENABLE_CRITIC_RETRY=true
MAX_RETRY=1
